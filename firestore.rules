rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isActive', true) == true;
    }

    function validEnrollment(data) {
      return data.keys().hasAll(['studentUid', 'courseId', 'status'])
        && data.keys().hasOnly(['studentUid', 'courseId', 'status', 'classId'])
        && data.studentUid is string
        && data.studentUid.size() > 0
        && data.courseId is string
        && data.courseId.size() > 0
        && data.status in ['active', 'inactive']
        && (!('classId' in data)
          || (data.classId is string
            && exists(/databases/$(database)/documents/classes/$(data.classId))
            && exists(/databases/$(database)/documents/teacherAssignments/$(data.courseId))
            && get(/databases/$(database)/documents/teacherAssignments/$(data.courseId)).data.status == 'active'
            && get(/databases/$(database)/documents/teacherAssignments/$(data.courseId)).data.classId == data.classId));
    }

    function validClass(data) {
      return data.keys().hasAll(['name', 'group', 'level', 'academicYear'])
        && data.keys().hasOnly(['name', 'group', 'level', 'academicYear'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.group is string && data.group.size() > 0 && data.group.size() <= 80
        && data.level is string && data.level.size() > 0 && data.level.size() <= 80
        && data.academicYear is string
        && data.academicYear.size() > 0
        && data.academicYear.size() <= 40;
    }

    function validSubject(data) {
      return data.keys().hasAll(['name', 'classIds'])
        && data.keys().hasOnly(['name', 'description', 'classIds'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.classIds is list && data.classIds.size() > 0 && data.classIds.size() <= 100
        && (!('description' in data)
          || (data.description is string && data.description.size() <= 1000));
    }

    function validTeacher(teacherUid) {
      let userPath = /databases/$(database)/documents/users/$(teacherUid);
      return teacherUid is string
        && exists(userPath)
        && get(userPath).data.role == 'teacher'
        && get(userPath).data.get('isActive', true) == true;
    }

    function validStudent(studentUid) {
      let userPath = /databases/$(database)/documents/users/$(studentUid);
      return studentUid is string
        && exists(userPath)
        && get(userPath).data.role == 'student'
        && get(userPath).data.get('isActive', true) == true;
    }

    function validTeacherAssignment(data) {
      let subjectPath = /databases/$(database)/documents/subjects/$(data.subject);
      return data.keys().hasAll(['teacherId', 'classId', 'subject', 'status'])
        && data.keys().hasOnly(['teacherId', 'classId', 'subject', 'status'])
        && data.teacherId is string
        && data.classId is string
        && data.subject is string
        && data.status in ['active', 'inactive']
        && exists(/databases/$(database)/documents/users/$(data.teacherId))
        && get(/databases/$(database)/documents/users/$(data.teacherId)).data.role == 'teacher'
        && (data.status == 'inactive'
          || get(/databases/$(database)/documents/users/$(data.teacherId))
            .data.get('isActive', true) == true)
        && exists(/databases/$(database)/documents/classes/$(data.classId))
        && exists(subjectPath)
        && get(subjectPath).data.classIds.hasAny([data.classId]);
    }

    function validCourse(data) {
      return data.keys().hasAll(['name', 'teacherName', 'teacherUid'])
        && data.keys().hasOnly([
          'name', 'teacherName', 'teacherUid', 'description'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.teacherName is string
        && data.teacherName.size() > 0
        && data.teacherName.size() <= 120
        && data.teacherUid is string
        && (!('description' in data)
          || (data.description is string && data.description.size() <= 2000));
    }

    function validSession(data) {
      return data.keys().hasAll(['courseId', 'teacherUid', 'startsAt'])
        && data.keys().hasOnly([
          'courseId', 'teacherUid', 'startsAt', 'endsAt', 'room', 'title',
          'mode', 'meetingUrl', 'status', 'startedAt', 'qrExpiresAt', 'closedAt'
        ])
        && data.courseId is string
        && data.teacherUid is string
        && data.startsAt is timestamp
        && (!('endsAt' in data)
          || (data.endsAt is timestamp && data.endsAt > data.startsAt))
        && (!('room' in data)
          || (data.room is string && data.room.size() <= 80))
        && (!('title' in data) || (data.title is string && data.title.size() <= 120))
        && (!('mode' in data) || data.mode in ['inPerson', 'online'])
        && (!('meetingUrl' in data) || (data.meetingUrl is string && data.meetingUrl.size() <= 500))
        && (!('status' in data) || data.status in ['scheduled', 'open', 'closed'])
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('qrExpiresAt' in data) || data.qrExpiresAt is timestamp)
        && (!('closedAt' in data) || data.closedAt is timestamp);
    }

    function isAdmin() {
      return isActiveAccount()
        && request.auth.token.get('admin', false) == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function isTeacher() {
      return isActiveAccount()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'teacher';
    }

    function enrollmentPath(studentUid, courseId) {
      return /databases/$(database)/documents/enrollments/$(studentUid + '_' + courseId);
    }

    function isEnrolled(courseId) {
      return signedIn()
        && exists(enrollmentPath(request.auth.uid, courseId))
        && get(enrollmentPath(request.auth.uid, courseId)).data.status == 'active';
    }

    function isCourseTeacher(courseId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return signedIn()
        && exists(coursePath)
        && get(coursePath).data.teacherUid == request.auth.uid;
    }

    function hasActiveAssignment(courseId) {
      let assignmentPath = /databases/$(database)/documents/teacherAssignments/$(courseId);
      return exists(assignmentPath)
        && get(assignmentPath).data.teacherId == request.auth.uid
        && get(assignmentPath).data.status == 'active';
    }

    function courseHasTeacher(courseId, teacherUid) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return exists(coursePath)
        && get(coursePath).data.teacherUid == teacherUid;
    }

    function canManageCourse(courseId) {
      return isAdmin() || (isTeacher() && isCourseTeacher(courseId) && hasActiveAssignment(courseId));
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'createdAt', 'className'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student';

      allow read: if isActiveAccount()
        && (request.auth.uid == userId || isAdmin());

      allow update: if isActiveAccount()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 120
            && request.resource.data.role == resource.data.role
          )
          || (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['role', 'className'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role'])
              || request.auth.uid != userId)
            && request.resource.data.role in [
              'student', 'teacher', 'admin'
            ]
            && (!('className' in request.resource.data)
              || (request.resource.data.className is string
                && request.resource.data.className.size() <= 80))
          )
        );

      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isActiveAccount()
          && (request.auth.uid == userId || isAdmin());
        allow create: if isAdmin()
          && request.resource.data.keys().hasAll([
            'title', 'message', 'createdAt', 'isRead'
          ])
          && request.resource.data.keys().hasOnly([
            'title', 'message', 'createdAt', 'isRead'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.isRead == false;
        allow update: if isActiveAccount()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
        allow delete: if false;
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isActiveAccount()
        && (
          resource.data.studentUid == request.auth.uid
          || isAdmin()
          || canManageCourse(resource.data.courseId)
        );

      allow create: if signedIn()
        && (
          isAdmin()
          || (
            isTeacher()
            && request.resource.data.studentUid is string
            && request.resource.data.courseId is string
            && canManageCourse(request.resource.data.courseId)
          )
        )
        && validEnrollment(request.resource.data)
        && validStudent(request.resource.data.studentUid)
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && enrollmentId
          == request.resource.data.studentUid + '_' + request.resource.data.courseId;

      allow update: if signedIn()
        && (
          isAdmin()
          || (
            isTeacher()
            && canManageCourse(resource.data.courseId)
            && request.resource.data.studentUid == resource.data.studentUid
            && request.resource.data.courseId == resource.data.courseId
          )
        )
        && validEnrollment(request.resource.data)
        && validStudent(request.resource.data.studentUid)
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
        && enrollmentId
          == request.resource.data.studentUid + '_' + request.resource.data.courseId;

      allow delete: if signedIn()
        && (
          isAdmin()
          || canManageCourse(resource.data.courseId)
        );
    }

    match /classes/{classId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validClass(request.resource.data);
      allow update: if isAdmin() && validClass(request.resource.data);
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validSubject(request.resource.data);
      allow update: if isAdmin() && validSubject(request.resource.data);
      allow delete: if isAdmin();
    }

    match /teacherAssignments/{assignmentId} {
      allow read: if isAdmin()
        || (isActiveAccount()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
          && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin() && validTeacherAssignment(request.resource.data);
      allow update: if isAdmin() && validTeacherAssignment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isActiveAccount()
        && (
          isAdmin()
          || (
            isTeacher()
            && resource.data.teacherUid == request.auth.uid
            && hasActiveAssignment(courseId)
          )
          || isEnrolled(courseId)
        );

      allow create: if isAdmin()
        && validCourse(request.resource.data)
        && validTeacher(request.resource.data.teacherUid);

      allow update: if (isAdmin()
        && validCourse(request.resource.data)
        && validTeacher(request.resource.data.teacherUid));

      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isActiveAccount()
        && (
          isAdmin()
          || (
            isTeacher()
            && resource.data.teacherUid == request.auth.uid
            && hasActiveAssignment(resource.data.courseId)
          )
          || isEnrolled(resource.data.courseId)
        );

      allow create: if (isAdmin()
        && validSession(request.resource.data)
        && courseHasTeacher(
          request.resource.data.courseId,
          request.resource.data.teacherUid
        ));

      allow update: if (isAdmin()
        && validSession(request.resource.data)
        && courseHasTeacher(
          request.resource.data.courseId,
          request.resource.data.teacherUid
        ))
        || (
          isTeacher()
          && validSession(request.resource.data)
          && resource.data.teacherUid == request.auth.uid
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
          && hasActiveAssignment(resource.data.courseId)
          && request.resource.data.get('status', resource.data.get('status', 'scheduled')) == resource.data.get('status', 'scheduled')
          && request.resource.data.get('startedAt', resource.data.get('startedAt', null)) == resource.data.get('startedAt', null)
          && request.resource.data.get('qrExpiresAt', resource.data.get('qrExpiresAt', null)) == resource.data.get('qrExpiresAt', null)
          && request.resource.data.get('closedAt', resource.data.get('closedAt', null)) == resource.data.get('closedAt', null)
        );

      allow delete: if isAdmin()
        || (isTeacher()
          && resource.data.teacherUid == request.auth.uid
          && hasActiveAssignment(resource.data.courseId));
    }

    match /attendance/{attendanceId} {
      allow read: if isActiveAccount()
        && (
          resource.data.studentUid == request.auth.uid
          || isAdmin()
          || (
            isTeacher()
            && resource.data.courseId is string
            && isCourseTeacher(resource.data.courseId)
              && hasActiveAssignment(resource.data.courseId)
          )
        );

      // Attendance writes are reserved for trusted server code.
      allow create, update, delete: if false;
    }
  }
}
